# .env do hub: o ./hub init gera este arquivo (em ~/.hub/dados/.env no Mac). Tem segredos: nunca compartilhe.
# Este modelo é só para referência; deixe em branco o que não usa.

# Telegram (obrigatório): token do bot (BotFather) e o chat do dono (descoberto pelo /start)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ferramentas de gestão (opcionais: cada uma liga só se configurada)
FUNIFIER_PM_MCP_URL=
BNEXO_MCP_URL=
BNEXO_MCP_TOKEN=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Resumo diário
RESUMO_HORARIO=09:00
TZ_HUB=America/Sao_Paulo

# Status nas ferramentas: true = muda para "em progresso" ao despachar e "concluída" com o seu Sim no Encerrar
HUB_ESCRITA_PM=true
# Opcional: IDs (vírgula) — com isso, a escrita vale só para essas tasks
HUB_ESCRITA_PM_SOMENTE=
# Comentários nas tasks: o hub só comenta com pedido explícito
HUB_COMENTARIOS_PM=false

# Opcional: aviso externo se o hub cair (./hub adicionar heartbeat)
# HUB_HEARTBEAT_URL=https://hc-ping.com/<código>

# ── Servidor: o hub.service já define estas variáveis (deploy/preparar-vm.sh); aqui só para referência. ──
# HUB_DADOS_DIR=/home/hub/dados          # banco, cofre cifrado, OAuth, logs, regras, apps.yaml
# HUB_RUNS_DIR=/srv/hub/runs             # prompts e anexos das tasks (o agente lê pelo grupo)
# HUB_REPOS_DIR=/srv/hub/repos           # pasta relativa no apps.yaml resolve aqui
# HUB_CLAUDE_DIR=/home/agente/.claude    # histórico das sessões de quem roda o Claude
# ORCA_BIN=/usr/bin/orca-ide
# ORCA_ENVIRONMENT=agente                # pareamento do hub com o Orca do usuário agente
# HUB_CONFIAR_PASTA_CMD=/usr/local/bin/hub-confiar-pasta
# HUB_COFRE=arquivo-cifrado              # keychain no Mac (padrão), arquivo-cifrado no servidor
# HUB_GIT_COMO=sudo -n -u agente         # git (clone, branches) roda como o agente
